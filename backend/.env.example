PORT=8080
# Comma-separated frontend origins. Use * only if this is a public API with no cookies.
CORS_ORIGIN=http://localhost:5173

# SMTP Configuration (Recommended: Brevo or Resend for high reliability and dynamic cloud IPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_app_password_or_api_key
SMTP_FROM="IP Law Firm" <yourname@gmail.com>

# Legacy Gmail Direct Config (Optional fallback, less reliable on Render)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where admin notification emails are delivered
ADMIN_EMAIL=yourname@gmail.com

# Optional Twilio WhatsApp
# ADMIN_WHATSAPP_NUMBER=+911234567890
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
