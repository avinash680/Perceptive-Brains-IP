PORT=8080
# Comma-separated frontend origins. Use * only if this is a public API with no cookies.
# `CLIENT_ORIGIN` can be used interchangeably for clarity in code.
CORS_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# SMTP / Mail configuration
# Examples: Gmail (use App Password), SendGrid (user=apikey), Mailgun, SES, Outlook
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Set your SMTP login here (for Gmail use an App Password)
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_here

# Mail sender: keep MAIL_FROM for compatibility, or use MAIL_FROM_NAME/MAIL_FROM_ADDRESS
MAIL_FROM_NAME="Perceptive Brains IP"
# Use a full email address here
MAIL_FROM_ADDRESS=onboarding@perceptivebrains.com
MAIL_FROM="Perceptive Brains IP" <onboarding@perceptivebrains.com>

# Admin notifications (comma-separated)
ADMIN_EMAILS=admin@example.com

# Optional Resend API configuration (if you use Resend instead of SMTP)
# RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Optional Twilio WhatsApp
# ADMIN_WHATSAPP_NUMBER=+911234567890
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
